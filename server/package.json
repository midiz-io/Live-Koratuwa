{
  "name": "garden-server",
  "version": "1.0.0",
  "description": "Backend server for Interactive Garden Experience",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "postinstall": "prisma generate",
    "setup": "node setup-database.js",
    "verify": "node verify-database.js",
    "migration-preview": "node show-migration.js",
    "test-stubs": "node test-api-stubs.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/blob": "^0.23.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "axios": "^1.6.2",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
