{
  "name": "interactive-garden-experience",
  "version": "1.0.0",
  "description": "Interactive Garden Experience - Garden Box Viewer",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "build": "npm run build --workspace=client",
    "postinstall": "npm run db:generate --workspace=server",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "db:setup": "cd server && npm run db:push && npm run db:seed",
    "db:reset": "cd server && npm run db:reset",
    "setup:verify": "node setup-verification.js",
    "test:api": "node test-functionality.js",
    "verify:boxes": "node verify-boxes-table.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "axios": "^1.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}